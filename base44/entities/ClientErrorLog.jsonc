{
  "name": "ClientErrorLog",
  "type": "object",
  "properties": {
    "error_message": {
      "type": "string",
      "description": "Mensagem do erro capturado pelo ErrorBoundary"
    },
    "error_stack": {
      "type": "string",
      "description": "Stack trace do erro (texto longo)"
    },
    "component_stack": {
      "type": "string",
      "description": "Component stack do React (texto longo)"
    },
    "page_url": {
      "type": "string",
      "description": "URL da p\u00e1gina onde o erro ocorreu"
    },
    "user_agent": {
      "type": "string",
      "description": "User agent do navegador/dispositivo"
    },
    "user_email": {
      "type": "string",
      "format": "email",
      "description": "Email do usu\u00e1rio logado (opcional)"
    },
    "triage_status": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "failed",
        "skipped"
      ],
      "default": "pending",
      "description": "Estado da triagem autom\u00e1tica do erro"
    },
    "triage_microsoft": {
      "type": "string",
      "description": "An\u00e1lise do erro pelo agente Microsoft Foundry"
    },
    "triage_openai": {
      "type": "string",
      "description": "An\u00e1lise do erro pelo agente ChatGPT"
    },
    "triage_completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data e hora da conclus\u00e3o da triagem"
    }
  },
  "required": [
    "error_message"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": true,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
