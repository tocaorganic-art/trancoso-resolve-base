{
  "name": "Lead",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome do lead"
    },
    "phone": {
      "type": "string",
      "description": "Telefone em formato internacional"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Email opcional"
    },
    "service_interest": {
      "type": "string",
      "description": "Servi\u00e7o de interesse"
    },
    "location": {
      "type": "string",
      "description": "Localidade informada pelo lead"
    },
    "source": {
      "type": "string",
      "enum": [
        "whatsapp",
        "facebook",
        "site",
        "indicacao",
        "google",
        "legado"
      ],
      "description": "Origem do lead"
    },
    "status": {
      "type": "string",
      "description": "Status do lead",
      "default": "novo"
    },
    "score": {
      "type": "number",
      "default": 0
    },
    "notes": {
      "type": "string",
      "description": "Anota\u00e7\u00f5es internas"
    },
    "consent": {
      "type": "boolean",
      "description": "Consentimento LGPD para contato"
    },
    "consent_at": {
      "type": "string",
      "format": "date-time",
      "description": "Momento do consentimento"
    },
    "nome": {
      "type": "string",
      "description": "Nome legado do lead"
    },
    "whatsapp": {
      "type": "string",
      "description": "WhatsApp legado do lead"
    },
    "bairro": {
      "type": "string",
      "description": "Bairro"
    },
    "horario": {
      "type": "string",
      "description": "Hor\u00e1rio preferido"
    },
    "servico": {
      "type": "string",
      "description": "Servi\u00e7o de interesse legado"
    },
    "origem": {
      "type": "string",
      "description": "Origem legada do lead"
    },
    "email_boas_vindas_enviado": {
      "type": "boolean",
      "default": false
    },
    "notas": {
      "type": "string",
      "description": "Notas legadas"
    },
    "profile_type": {
      "type": "string",
      "enum": [
        "cliente",
        "prestador",
        "lojista",
        "empresa"
      ]
    },
    "locality": {
      "type": "string",
      "description": "Localidade legada"
    },
    "category_interest": {
      "type": "string",
      "description": "Categoria legada"
    },
    "message": {
      "type": "string",
      "description": "Mensagem do lead"
    },
    "utm_source": {
      "type": "string"
    },
    "utm_medium": {
      "type": "string"
    },
    "utm_campaign": {
      "type": "string"
    },
    "lead_status": {
      "type": "string",
      "enum": [
        "new",
        "in_review",
        "qualified",
        "contacted",
        "converted",
        "not_qualified",
        "archived"
      ],
      "default": "new"
    }
  },
  "required": [
    "name",
    "phone",
    "source",
    "consent"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}