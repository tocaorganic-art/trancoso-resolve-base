{
  "name": "Lead",
  "type": "object",
  "properties": {
    "name": { "type": "string", "description": "Nome do lead" },
    "phone": { "type": "string", "description": "Telefone em formato internacional" },
    "email": { "type": "string", "format": "email", "description": "Email opcional" },
    "service_interest": { "type": "string", "description": "Serviço de interesse" },
    "location": { "type": "string", "description": "Localidade informada pelo lead" },
    "source": {
      "type": "string",
      "enum": ["whatsapp", "facebook", "site", "indicacao", "google", "legado"],
      "description": "Origem do lead"
    },
    "status": { "type": "string", "description": "Status do lead", "default": "novo" },
    "score": { "type": "number", "default": 0 },
    "notes": { "type": "string", "description": "Anotações internas" },
    "consent": { "type": "boolean", "description": "Consentimento LGPD para contato" },
    "consent_at": { "type": "string", "format": "date-time", "description": "Momento do consentimento" },

    // Campos legados preservados para compatibilidade com relatórios e telas administrativas.
    "nome": { "type": "string", "description": "Nome legado do lead" },
    "whatsapp": { "type": "string", "description": "WhatsApp legado do lead" },
    "bairro": { "type": "string", "description": "Bairro" },
    "horario": { "type": "string", "description": "Horário preferido" },
    "servico": { "type": "string", "description": "Serviço de interesse legado" },
    "origem": { "type": "string", "description": "Origem legada do lead" },
    "email_boas_vindas_enviado": { "type": "boolean", "default": false },
    "notas": { "type": "string", "description": "Notas legadas" },
    "profile_type": { "type": "string", "enum": ["cliente", "prestador", "lojista", "empresa"] },
    "locality": { "type": "string", "description": "Localidade legada" },
    "category_interest": { "type": "string", "description": "Categoria legada" },
    "message": { "type": "string", "description": "Mensagem do lead" },
    "utm_source": { "type": "string" },
    "utm_medium": { "type": "string" },
    "utm_campaign": { "type": "string" },

    // [OpenAI Ads] Campos novos — adicionados para mensuração de campanhas OpenAI Ads.
    // utm_source/utm_medium/utm_campaign já existiam acima; estes três são novos:
    "utm_content": { "type": "string", "description": "UTM content (ex.: variante de anúncio)" },
    "utm_term": { "type": "string", "description": "UTM term (ex.: termo de busca/segmentação)" },
    "oppref": { "type": "string", "description": "Parâmetro oficial de atribuição de clique da OpenAI Ads (help.openai.com/en/articles/20001409-conversion-measurement)" },
    "event_id": { "type": "string", "description": "UUID gerado no momento da criação do lead, usado para deduplicação Pixel + Conversions API" },

    "lead_status": {
      "type": "string",
      "enum": ["new", "in_review", "qualified", "contacted", "converted", "not_qualified", "archived"],
      "default": "new"
    }
  },
  "required": ["name", "phone", "source", "consent"],
  "rls": {
    "create": null,
    "read": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
