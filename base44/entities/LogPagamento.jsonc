{
  "name": "LogPagamento",
  "type": "object",
  "properties": {
    "prestador_id": {
      "type": "string",
      "description": "ID do ServiceProvider vinculado ao pagamento (quando aplic\u00e1vel)"
    },
    "prestador_email": {
      "type": "string",
      "format": "email",
      "description": "Email do prestador (denormalizado para busca)"
    },
    "evento": {
      "type": "string",
      "description": "Tipo do evento (ex: subscription_preapproval, payment, vencimento)"
    },
    "valor": {
      "type": "number",
      "description": "Valor da transa\u00e7\u00e3o em BRL (quando aplic\u00e1vel)"
    },
    "status": {
      "type": "string",
      "description": "Status do evento (ex: authorized, cancelled, paused, pending, approved, expired)"
    },
    "mercadopago_id": {
      "type": "string",
      "description": "ID do recurso no Mercado Pago (preapproval_id ou payment_id)"
    },
    "plano": {
      "type": "string",
      "description": "Plano associado (ex: profissional, prestador_elite, lojista_essencial)"
    },
    "payload_raw": {
      "type": "string",
      "description": "Payload bruto do evento (JSON stringificado, sem dados sens\u00edveis)"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Momento do evento"
    }
  },
  "required": [
    "evento",
    "timestamp"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": true,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}