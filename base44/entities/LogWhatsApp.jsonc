{
  "name": "LogWhatsApp",
  "type": "object",
  "properties": {
    "prestador_id": {
      "type": "string",
      "description": "ID do ServiceProvider destinat\u00e1rio"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "boas_vindas_plano",
        "lead_novo",
        "lembrete_renovacao",
        "verificacao_aprovada",
        "aviso_admin",
        "recebido"
      ],
      "description": "Tipo da mensagem enviada (recebido = mensagem inbound do cliente via webhook)"
    },
    "telefone": {
      "type": "string",
      "description": "N\u00famero de destino no formato E.164 (ex: +5573999999999)"
    },
    "mensagem": {
      "type": "string",
      "description": "Texto da mensagem enviada"
    },
    "status": {
      "type": "string",
      "enum": [
        "enviado",
        "falhou",
        "pendente",
        "recebido"
      ],
      "default": "pendente",
      "description": "Status do envio (recebido = mensagem inbound registrada)"
    },
    "message_id": {
      "type": "string",
      "description": "ID da mensagem retornado pelo provedor (WhatsApp Business API / Z-API / etc)"
    },
    "erro": {
      "type": "string",
      "description": "Detalhes do erro em caso de falha"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora do envio"
    },
    "referencia_id": {
      "type": "string",
      "description": "ID do objeto relacionado (Subscription, ServiceRequest, etc)"
    },
    "referencia_tipo": {
      "type": "string",
      "description": "Tipo do objeto relacionado (Subscription, ServiceRequest, etc)"
    }
  },
  "required": [
    "tipo",
    "telefone"
  ],
  "rls": {
    "create": null,
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}