{
  "name": "Payment",
  "type": "object",
  "properties": {
    "request_id": {
      "type": "string",
      "description": "ID da ServiceRequest vinculada"
    },
    "provider_id": {
      "type": "string",
      "description": "ID do prestador"
    },
    "client_email": {
      "type": "string",
      "description": "Email do cliente"
    },
    "amount_total": {
      "type": "number",
      "description": "Valor total em centavos"
    },
    "amount_provider": {
      "type": "number",
      "description": "80% para o prestador (centavos)"
    },
    "amount_platform": {
      "type": "number",
      "description": "20% para a plataforma (centavos)"
    },
    "currency": {
      "type": "string",
      "default": "brl",
      "description": "Moeda"
    },
    "mp_payment_id": {
      "type": "string",
      "description": "ID do pagamento no Mercado Pago"
    },
    "mp_preference_id": {
      "type": "string",
      "description": "ID da prefer\u00eancia de pagamento no Mercado Pago"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "captured",
        "canceled",
        "refunded"
      ],
      "default": "pending",
      "description": "Status do pagamento"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da captura"
    },
    "service_date": {
      "type": "string",
      "format": "date",
      "description": "Data do servi\u00e7o"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "request_id",
    "provider_id",
    "amount_total"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.client_email": "{{user.email}}"
        },
        {
          "data.provider_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}