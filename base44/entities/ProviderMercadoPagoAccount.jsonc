{
  "name": "ProviderMercadoPagoAccount",
  "type": "object",
  "properties": {
    "provider_id": {
      "type": "string",
      "description": "ID do prestador"
    },
    "mp_user_id": {
      "type": "string",
      "description": "User ID da conta Mercado Pago do prestador"
    },
    "mp_access_token": {
      "type": "string",
      "description": "Access token OAuth do prestador no MP"
    },
    "mp_public_key": {
      "type": "string",
      "description": "Public key do prestador no MP"
    },
    "mp_refresh_token": {
      "type": "string",
      "description": "Refresh token OAuth do prestador no MP"
    },
    "mp_onboarding_completed": {
      "type": "boolean",
      "default": false,
      "description": "Se o onboarding MP foi conclu\u00eddo"
    },
    "charges_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Se cobran\u00e7as est\u00e3o habilitadas"
    },
    "payouts_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Se pagamentos/saques est\u00e3o habilitados"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Notas sobre a conta MP"
    }
  },
  "required": [
    "provider_id"
  ],
  "rls": {
    "read": {
      "created_by": "{{user.email}}"
    },
    "write": {
      "created_by": "{{user.email}}"
    }
  }
}