{
  "name": "ProviderSchedule",
  "type": "object",
  "properties": {
    "provider_id": {
      "type": "string",
      "description": "ID do prestador"
    },
    "weekly_availability": {
      "type": "object",
      "description": "Disponibilidade semanal. Chave = dia da semana como string ('0'=domingo...'6'=sabado). Valor = { enabled: boolean, slots: string[] (horarios HH:MM) }"
    },
    "blocked_dates": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Datas bloqueadas pelo prestador (folgas/feriados), formato YYYY-MM-DD"
    },
    "advance_booking_days": {
      "type": "integer",
      "default": 1,
      "description": "Dias minimos de antecedencia para agendar"
    },
    "max_booking_days": {
      "type": "integer",
      "default": 60,
      "description": "Dias maximos no futuro para permitir agendamento"
    },
    "day_of_week": {
      "type": "integer",
      "minimum": 0,
      "maximum": 6,
      "description": "(Legado) Dia da semana (0=domingo, 6=sabado)"
    },
    "start_time": {
      "type": "string",
      "description": "(Legado) Horario de inicio (HH:MM)"
    },
    "end_time": {
      "type": "string",
      "description": "(Legado) Horario de encerramento (HH:MM)"
    },
    "is_available": {
      "type": "boolean",
      "default": true,
      "description": "Se o prestador esta disponivel neste horario"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Descricao da disponibilidade ou notas"
    }
  },
  "required": [
    "provider_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": true,
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}