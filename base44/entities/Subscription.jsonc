{
  "name": "Subscription",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "format": "email",
      "description": "Email do usu\u00e1rio"
    },
    "plan": {
      "type": "string",
      "enum": [
        "gratuito",
        "profissional",
        "elite",
        "prestador_elite",
        "lojista_essencial",
        "lojista_pro",
        "lojista_elite",
        "boost_prestador",
        "boost_lojista"
      ],
      "default": "gratuito",
      "description": "Plano da assinatura"
    },
    "plan_category": {
      "type": "string",
      "enum": [
        "prestador",
        "lojista",
        "boost"
      ],
      "default": "prestador",
      "description": "Categoria do plano (prestador, lojista ou boost sazonal)"
    },
    "is_annual": {
      "type": "boolean",
      "default": false,
      "description": "Se a cobran\u00e7a \u00e9 anual (paga 10, leva 12 \u2014 2 meses gr\u00e1tis)"
    },
    "founder_badge": {
      "type": "boolean",
      "default": false,
      "description": "Selo de fundador \u2014 concedido aos primeiros assinantes (vagas limitadas)"
    },
    "status": {
      "type": "string",
      "enum": [
        "trial",
        "active",
        "pending",
        "expired",
        "cancelled"
      ],
      "default": "trial",
      "description": "Status da assinatura"
    },
    "trial_start": {
      "type": "string",
      "format": "date",
      "description": "Data de in\u00edcio do trial"
    },
    "trial_end": {
      "type": "string",
      "format": "date",
      "description": "Data de fim do trial"
    },
    "subscription_start": {
      "type": "string",
      "format": "date",
      "description": "Data de in\u00edcio da assinatura paga"
    },
    "next_billing_date": {
      "type": "string",
      "format": "date",
      "description": "Pr\u00f3xima data de cobran\u00e7a"
    },
    "mp_preapproval_id": {
      "type": "string",
      "description": "ID da assinatura recorrente no Mercado Pago (Preapproval)"
    },
    "amount": {
      "type": "number",
      "default": 0,
      "description": "Valor da mensalidade em R$"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "mercadopago",
        "manual"
      ],
      "default": "mercadopago",
      "description": "M\u00e9todo de pagamento"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es administrativas"
    }
  },
  "required": [
    "user_email",
    "plan",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}