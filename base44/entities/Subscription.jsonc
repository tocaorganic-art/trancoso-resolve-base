{
  "name": "Subscription",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "format": "email",
      "description": "Email do usu\u00e1rio"
    },
    "plan": {
      "type": "string",
      "enum": [
        "trial",
        "monthly",
        "profissional",
        "prestador_elite",
        "lojista_essencial",
        "lojista_pro",
        "lojista_elite",
        "boost_prestador",
        "boost_lojista"
      ],
      "default": "trial",
      "description": "Plano da assinatura"
    },
    "status": {
      "type": "string",
      "enum": [
        "trial",
        "active",
        "expired",
        "cancelled"
      ],
      "default": "trial",
      "description": "Status da assinatura"
    },
    "billing": {
      "type": "string",
      "enum": [
        "monthly",
        "annual"
      ],
      "default": "monthly",
      "description": "Ciclo de cobran\u00e7a"
    },
    "trial_start": {
      "type": "string",
      "format": "date",
      "description": "Data de in\u00edcio do trial"
    },
    "trial_end": {
      "type": "string",
      "format": "date",
      "description": "Data de fim do trial"
    },
    "trial_consumed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp ISO da primeira vez que qualquer benef\u00edcio de trial foi consumido. Preenchido na concess\u00e3o do Teste Gratuito (30d) ou do trial Profissional (7d). Nunca apagado ou reatribu\u00eddo."
    },
    "trial_type": {
      "type": "string",
      "enum": [
        "free_30d",
        "profissional_7d"
      ],
      "description": "Tipo do primeiro trial consumido. 'free_30d' = Teste Gratuito sem cart\u00e3o; 'profissional_7d' = trial do Plano Profissional com cart\u00e3o."
    },
    "trial_version": {
      "type": "integer",
      "default": 1,
      "description": "Vers\u00e3o da regra de trial no momento do consumo. Usar para auditoria e reconcilia\u00e7\u00e3o se a pol\u00edtica mudar."
    },
    "subscription_start": {
      "type": "string",
      "format": "date",
      "description": "Data de in\u00edcio da assinatura paga"
    },
    "next_billing_date": {
      "type": "string",
      "format": "date",
      "description": "Pr\u00f3xima data de cobran\u00e7a"
    },
    "mp_preapproval_id": {
      "type": "string",
      "description": "ID da assinatura (preapproval) no Mercado Pago"
    },
    "mp_payer_id": {
      "type": "string",
      "description": "ID do pagador no Mercado Pago"
    },
    "amount": {
      "type": "number",
      "default": 99,
      "description": "Valor da mensalidade em R$"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "mercadopago",
        "manual"
      ],
      "default": "mercadopago",
      "description": "M\u00e9todo de pagamento"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es administrativas"
    }
  },
  "required": [
    "user_email",
    "plan",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}