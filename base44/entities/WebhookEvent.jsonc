{
  "name": "WebhookEvent",
  "type": "object",
  "description": "Log de idempot\u00eancia para webhooks externos. Garante que o mesmo evento n\u00e3o seja processado duas vezes. PRIVADO \u2014 nunca exposto ao p\u00fablico ou ao prestador.",
  "properties": {
    "provider": {
      "type": "string",
      "description": "Provedor do webhook: mercadopago, stripe, etc."
    },
    "external_event_id": {
      "type": "string",
      "description": "ID \u00fanico do evento no provedor externo (ex: preapproval_id do MP)"
    },
    "external_resource_id": {
      "type": "string",
      "description": "ID do recurso afetado (ex: subscription_id, payment_id)"
    },
    "event_type": {
      "type": "string",
      "description": "Tipo do evento (ex: subscription_preapproval, payment.created)"
    },
    "payload_hash": {
      "type": "string",
      "description": "Hash SHA-256 do payload (sem PII). Usado para detectar replays com payload diferente."
    },
    "status": {
      "type": "string",
      "enum": [
        "processing",
        "processed",
        "failed",
        "pending_reconciliation"
      ],
      "default": "processing",
      "description": "processing = em processo; processed = conclu\u00eddo com sucesso; failed = falhou definitivamente; pending_reconciliation = falhou mas precisa de a\u00e7\u00e3o manual"
    },
    "attempts": {
      "type": "integer",
      "default": 1,
      "description": "N\u00famero de tentativas de processamento"
    },
    "received_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora do recebimento do evento"
    },
    "processed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da conclus\u00e3o do processamento"
    },
    "last_error": {
      "type": "string",
      "description": "Mensagem do \u00faltimo erro (sem dados sens\u00edveis)"
    },
    "next_retry_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora agendada para nova tentativa (se aplic\u00e1vel)"
    },
    "subscription_id": {
      "type": "string",
      "description": "ID interno da Subscription associada (para rastreamento)"
    }
  },
  "required": [
    "provider",
    "external_event_id",
    "event_type",
    "status",
    "received_at"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}