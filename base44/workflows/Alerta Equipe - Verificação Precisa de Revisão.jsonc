{
  "name": "Alerta Equipe - Verifica\u00e7\u00e3o Precisa de Revis\u00e3o",
  "description": "Quando status_verificacao de um prestador muda para em_analise_manual ou reprovado, avisa a equipe com o motivo registrado, sem dado sens\u00edvel.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status_verificacao\") != null) and ((.trigger.data.status_verificacao == \"em_analise_manual\") or (.trigger.data.status_verificacao == \"reprovado\"))) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "ServiceProvider"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "notificar_admin_verificacao",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notificarAdminVerificacao",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "notificarAdminVerificacao"
  }
}