{
  "name": "Alerta Novo Prestador \u2014 WhatsApp",
  "description": "Envia email de alerta instant\u00e2neo para a equipe quando um novo prestador se cadastra, com link wa.me de um toque para contato imediato via WhatsApp.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "ServiceProvider"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "alerta_novo_prestador_whatsapp",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyNewProvider",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "notifyNewProvider"
  }
}