{
  "name": "Antecedentes Aprovados \u2014 Notificar Prestador",
  "description": "Quando a verifica\u00e7\u00e3o de antecedentes de um ServiceProvider \u00e9 aprovada (status_verificacao muda para 'aprovado'), envia e-mail autom\u00e1tico ao prestador informando o resultado. Se o prestador j\u00e1 est\u00e1 totalmente verificado, a fun\u00e7\u00e3o ignora (boas-vindas j\u00e1 enviadas pelo adminVerificacao).",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status_verificacao\") != null) and (.trigger.data.status_verificacao == \"aprovado\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "ServiceProvider"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "antecedentes_aprovados_notificar_prestador",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notificarAntecedentesAprovados",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "notificarAntecedentesAprovados"
  }
}