{
  "name": "An\u00e1lise IA - Nova Verifica\u00e7\u00e3o de Identidade",
  "description": "Chama a fun\u00e7\u00e3o de an\u00e1lise de documento por IA sempre que uma nova verifica\u00e7\u00e3o \u00e9 criada",
  "trigger": {
    "condition": "${ (.trigger.data.status == \"Em An\\u00e1lise\") }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Verificacao"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "an_lise_ia_nova_verifica_o_de_identidade",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "analisarDocumento",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "analisarDocumento"
  }
}