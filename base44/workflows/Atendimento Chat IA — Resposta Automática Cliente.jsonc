{
  "name": "Atendimento Chat IA \u2014 Resposta Autom\u00e1tica Cliente",
  "description": "Quando um ChatMessage \u00e9 criado com sender_role = client, chama atendimento_chat_ia para gerar resposta autom\u00e1tica ao cliente.",
  "trigger": {
    "condition": "${ (.trigger.data.sender_role == \"client\") }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "ChatMessage"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "atendimento_chat_ia_resposta_autom_tica_cliente",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "atendimento_chat_ia",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "atendimento_chat_ia"
  }
}