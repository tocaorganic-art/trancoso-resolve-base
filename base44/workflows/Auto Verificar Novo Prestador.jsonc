{
  "name": "Auto Verificar Novo Prestador",
  "description": "Quando o ServiceProviderPrivate \u00e9 criado com CPF e data de nascimento (ap\u00f3s o cadastro salvar os dados sens\u00edveis), chama verificarAntecedentes. A fun\u00e7\u00e3o decide: consulta (somente com INFOSIMPLES_CONSULTA_ATIVA=true), an\u00e1lise manual (PJ, dados faltando ou consulta desligada) ou recusa sem autoriza\u00e7\u00e3o.",
  "trigger": {
    "condition": "${ (((.trigger.data.cpf // \"\") != \"\") and ((.trigger.data.data_nascimento // \"\") != \"\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "ServiceProviderPrivate"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_verificar_novo_prestador",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "verificarAntecedentes",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "verificarAntecedentes"
  }
}