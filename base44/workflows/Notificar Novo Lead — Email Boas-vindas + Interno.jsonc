{
  "name": "Notificar Novo Lead \u2014 Email Boas-vindas + Interno",
  "description": "",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "LeadPreLancamento"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "notificar_novo_lead_email_boas_vindas_interno",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyNewLead",
            "args": {
              "leadId": "{{entity_id}}"
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "notifyNewLead"
  }
}