{
  "name": "Notificar confirma\u00e7\u00e3o de agendamento",
  "description": "Quando o prestador confirma o pedido (status \u2192 Confirmado), envia email para cliente e prestador.",
  "trigger": {
    "condition": "${ ((.trigger.data.status == \"Confirmado\") and (.trigger.changed_fields | index(\"status\") != null)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "ServiceRequest"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "notificar_confirma_o_de_agendamento",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyBookingConfirmation",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "notifyBookingConfirmation"
  }
}