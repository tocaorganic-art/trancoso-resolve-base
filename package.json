{
  "name": "base44-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender-head.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p ./jsconfig.json",
    "test": "node --test \"tests/**/*.test.js\"",
    "preview": "vite preview",
    "prerender": "node scripts/prerender-head.js",
    "sitemap": "node scripts/generate-sitemap.js",
    "deploy": "node -e \"const p=process.platform;require('child_process').execSync(p==='win32'?'pwsh -File scripts/deploy.ps1':'bash scripts/deploy.sh',{stdio:'inherit'})\"",
    "deploy:auto": "npm run deploy",
    "deploy:windows": "pwsh -File scripts/deploy.ps1",
    "deploy:unix": "bash scripts/deploy.sh",
    "deploy:vercel": "npx vercel deploy --prod --yes",
    "deploy:base44": "npx base44 deploy --yes",
    "deploy:base44:fn": "npx base44 functions deploy",
    "deploy:base44:entities": "npx base44 entities push",
    "test:investors": "vitest run src/components/investors/investors.test.jsx",
    "test:all": "vitest run"
  },
  "dependencies": {
